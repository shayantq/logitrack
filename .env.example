# این فایل را به .env کپی کنید و مقادیر را تغییر دهید.
# docker compose این فایل را خودکار می‌خواند.

# کلید امضای توکن‌های ورود (الزامی در محیط واقعی)
# ساخت یک کلید امن:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string

# فقط روی سرور اصلی: production
# با این مقدار، برنامه با SECRET_KEY خالی، کوتاه‌تر از ۳۲ نویسه یا نمونه، و با رمز نمونه دیتابیس بالا نمی‌آید
# و مستندات API (/docs) بسته می‌شود. قبل از فعال‌کردن:  docker compose run --rm --no-deps web python -m app.security_preflight
APP_ENV=development

# مدت اعتبار توکن دسترسی (دقیقه) — کوتاه است و مرورگر با کوکی امن نشست خودکار تمدیدش می‌کند؛
# ماندگاری ورود: ۱۲ ساعت، یا ۳۰ روز با «مرا به خاطر بسپار»
ACCESS_TOKEN_EXPIRE_MINUTES=30

# پورت‌های روی کامپیوتر میزبان (8000 دست پروژه ATS و 5432 دست PostgreSQL ویندوز است)
WEB_PORT=8001
DB_PORT=5433

# رمز دیتابیس داکر — اگر عوض کنید، فقط روی volume خالی اعمال می‌شود
POSTGRES_PASSWORD=your_secure_password

# فقط اگر فرانت‌اند/کلاینت روی دامنه دیگری است؛ چند آدرس را با کاما جدا کنید
CORS_ORIGINS=

# فقط برای اجرای محلی بدون داکر، با PostgreSQL نصب‌شده روی ویندوز (داخل داکر از docker-compose.yml تنظیم می‌شوند)
DATABASE_URL=postgresql://postgres:123456@localhost:5432/logitrack
REDIS_URL=redis://localhost:6379/0

# ---- فقط روی سرور اصلی (HTTPS با Caddy — docker-compose.prod.yml) ----
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# DOMAIN=example.ir
# WEB_PORT=127.0.0.1:8001
# CELERY_CONCURRENCY=1

# ---- پیامک و ایمیل خودکار (اختیاری؛ تا تنظیم نشوند فقط در لاگ ثبت می‌شوند) ----
# SMS_PROVIDER=kavenegar
# SMS_API_KEY=
# SMS_SENDER=
# ORDER_SMS_ENABLED=0
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@passineh.ir
# PUBLIC_BASE_URL=https://passineh.ir

# ---- نسخه نمایشی خصوصی (اختیاری) ----
# لینک: https://<دامنه>/app/d/<DEMO_ACCESS_TOKEN> — بدون ورود، داشبورد ادمین یک سازمان فرضی؛ هر ۳۰ دقیقه ریست می‌شود
# ساخت توکن:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# بعد از تنظیم:  docker compose exec web python -m app.demo_db build
# DEMO_ACCESS_TOKEN=

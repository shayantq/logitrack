# این فایل را به .env کپی کنید و مقادیر را تغییر دهید.
# docker compose این فایل را خودکار می‌خواند.

# کلید امضای توکن‌های ورود (الزامی در محیط واقعی)
# ساخت یک کلید امن:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string

# مدت اعتبار توکن ورود (دقیقه)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# پورت‌های روی کامپیوتر میزبان (8000 دست پروژه ATS و 5432 دست PostgreSQL ویندوز است)
WEB_PORT=8001
DB_PORT=5433

# رمز دیتابیس داکر — اگر عوض کنید، فقط روی volume خالی اعمال می‌شود
POSTGRES_PASSWORD=your_secure_password

# فقط اگر فرانت‌اند/کلاینت روی دامنه دیگری است؛ چند آدرس را با کاما جدا کنید
CORS_ORIGINS=

# فقط برای اجرای محلی بدون داکر، با PostgreSQL نصب‌شده روی ویندوز (داخل داکر از docker-compose.yml تنظیم می‌شوند)
DATABASE_URL=postgresql://postgres:123456@localhost:5432/logitrack
REDIS_URL=redis://localhost:6379/0

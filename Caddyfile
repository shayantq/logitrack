# Caddy — HTTPS خودکار (گواهی رایگان و تمدید خودکار) و هدایت درخواست‌ها به برنامه (docker-compose.prod.yml)

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip
	# ویدیوی احراز هویت راننده تا ۳۰ مگابایت
	request_body {
		max_size 40MB
	}
	reverse_proxy web:8000
}
